{
	"name": "balatd/db_friendlycaptcha",
	"type": "typo3-cms-extension",
	"description": "Bot protection for the internet.",
	"homepage": "https://github.com/balatD/",
	"license": [
		"GPL-2.0-or-later"
	],
	"keywords": [
		"friendly captcha"
	],
	"support": {
		"source": "https://github.com/balatD/db_friendlycaptcha",
		"issues": "https://github.com/balatD/db_friendlycaptcha/issues"
	},
	"require": {
		"typo3/cms-core": "^12.4 || dev-main",
		"typo3/cms-extbase": "^12.4 || dev-main",
		"typo3/cms-fluid": "^12.4 || dev-main",
		"typo3/cms-frontend": "^12.4 || dev-main"
	},
	"suggest": {
		"typo3/cms-form": "*"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "friendlycaptcha"
		}
	},
	"autoload": {
		"psr-4": {
			"BalatD\\FriendlyCaptcha\\": "Classes/"
		}
	}
}
